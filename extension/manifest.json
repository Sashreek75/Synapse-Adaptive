{
  "manifest_version": 3,
  "name": "Synapse Orb",
  "version": "0.1.0",
  "description": "Synapse at the edge of your browser: argue your way past distractions, and get clarity on what's in front of you.",
  "icons": { "16": "icons/orb-16.png", "32": "icons/orb-32.png", "48": "icons/orb-48.png", "128": "icons/orb-128.png" },
  "action": { "default_title": "Synapse settings", "default_icon": { "16": "icons/orb-16.png", "32": "icons/orb-32.png" } },
  "background": { "service_worker": "background.js" },
  "options_page": "options.html",
  "permissions": ["storage", "tabs", "alarms", "notifications"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_start", "all_frames": false }
  ],
  "commands": {
    "toggle-orb": { "suggested_key": { "default": "Alt+Shift+S" }, "description": "Open or close the Synapse orb" }
  }
}
