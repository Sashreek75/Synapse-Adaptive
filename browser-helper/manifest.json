{
  "manifest_version": 3,
  "name": "Synapse Helper",
  "version": "0.1.0",
  "description": "Lets the Synapse app on your computer see which site you're on and hold or close distracting tabs. Has no interface of its own.",
  "key": "",
  "icons": { "16": "icons/orb-16.png", "48": "icons/orb-48.png", "128": "icons/orb-128.png" },
  "background": { "service_worker": "background.js" },
  "permissions": ["tabs", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["veil.js"], "run_at": "document_start", "all_frames": false }
  ]
}
