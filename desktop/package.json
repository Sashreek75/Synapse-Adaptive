{
  "name": "synapse",
  "productName": "Synapse",
  "version": "0.1.1",
  "description": "Synapse \u2014 the layer between what you intend to do and what you actually do.",
  "author": "Synapse",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs && electron .",
    "typecheck": "tsc --noEmit -p .",
    "test": "node build.mjs --test && node dist/core.test.js",
    "dist": "node build.mjs && electron-builder",
    "dist:win": "node build.mjs && electron-builder --win nsis --x64",
    "dist:mac": "node build.mjs && electron-builder --mac"
  },
  "dependencies": {
    "koffi": "^2.9.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/ws": "^8.5.12",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "typescript": "^5.5.3"
  },
  "build": {
    "appId": "com.synapse.orb",
    "productName": "Synapse",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../browser-helper",
        "to": "browser-helper"
      }
    ],
    "asarUnpack": [
      "node_modules/koffi/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "SynapseSetup.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "Synapse"
    },
    "publish": null,
    "afterPack": "build/afterPack.cjs",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "identity": null,
      "artifactName": "Synapse-mac.dmg",
      "files": [
        "!node_modules/koffi/**"
      ],
      "extendInfo": {
        "LSUIElement": true,
        "NSAppleEventsUsageDescription": "Synapse checks which app is in front so it knows when you're working.",
        "NSScreenCaptureUsageDescription": "Synapse looks at your screen only when you ask it something with the eye switched on."
      }
    },
    "dmg": {
      "title": "Synapse",
      "artifactName": "Synapse-mac.dmg"
    }
  }
}